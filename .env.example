# Extraction pipeline (server only, never NEXT_PUBLIC_)
# EXTRACT_PROVIDER: "paddle" (default) = PaddleOCR-VL then DeepSeek Flash;
# "gemini" = skip straight to Gemini. Gemini is also the automatic fallback
# when the PaddleOCR or DeepSeek stage fails.
EXTRACT_PROVIDER=paddle

# PaddleOCR-VL via Baidu AI Studio — does the vision/OCR. Image goes here.
PADDLEOCR_AISTUDIO_TOKEN=
PADDLEOCR_MODEL=PP-OCRv6
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com

# DeepSeek Flash — structures OCR text, and is the last-resort vision fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=4000

# Attempt budgets. PaddleOCR gets enough room to finish through the AI Studio
# queue; on timeout we go to DeepSeek vision (cheap) and keep Gemini last.
PADDLEOCR_TIMEOUT_MS=10000
DEEPSEEK_TIMEOUT_MS=5500
GEMINI_TIMEOUT_MS=5500

# Optional: intermediate OCR payload sent to DeepSeek (currently "markdown").
OCR_FORMAT=markdown

# Fallback only (image -> receipt JSON).
GEMINI_API_KEY=

# Google OAuth (Phase 1 Sheets) — server only, never NEXT_PUBLIC_
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in Google Cloud Console
# Add all three: https://www.zippp.link/api/auth/callback, https://zippp.link/api/auth/callback, http://localhost:3000/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Donation photos go to the operator's Google Drive with a dedicated refresh
# token (scope drive.file), not the signed-in user's token. Generate it once:
#   node scripts/donation-drive-auth.mjs
DONATION_GOOGLE_REFRESH_TOKEN=
# Optional: write to an existing folder instead of creating "[zippp] donations".
DONATION_DRIVE_FOLDER_ID=
DONATION_DRIVE_FOLDER_NAME=

# Mailtrap transactional email. Leave MAILTRAP_INBOX_ID empty for real
# delivery; set it to capture mail in a sandbox inbox instead.
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=
MAILTRAP_FROM_NAME=zippp
MAILTRAP_INBOX_ID=

# OAuth scopes (set in code): spreadsheets + drive.file
# After adding drive.file: Disconnect Google → Sign in again to re-consent.
# Also enable Google Drive API in Cloud Console (APIs & Services → Library).

# Optional but recommended: encrypt refresh tokens at rest (AES-256-GCM).
# Use a 64-char hex string (32 bytes), or any passphrase (SHA-256 derived).
# Generate hex: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional override for token store directory (default: <repo>/.data).
# Local dev only — on servers, prefer a durable backend below.
# ZIPPP_DATA_DIR=

# Durable token store backends (pick one; Vercel Blob wins if both are set).
# Records keep TOKEN_ENCRYPTION_KEY encryption regardless of backend.
# 1) Vercel Blob: set BLOB_READ_WRITE_TOKEN (from Vercel → Storage → Blob).
# 2) Upstash Redis REST: set both UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Without either, the filesystem store (ZIPPP_DATA_DIR / .data) is used.
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Billing / admin (server only) — never commit real values.
ADMIN_EMAILS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PACK_PRICE_ID=
PADDLE_CLIENT_TOKEN=
# Manual GoPay top-up (Indonesia). Active path while DOKU QRIS is halted.
GOPAY_NUMBER=
GOPAY_NAME=

# DOKU Checkout (Indonesia) — QRIS halted; code kept for later.
# sandbox -> api-sandbox.doku.com, production -> api.doku.com.
# Notification URL in DOKU Back Office: https://<host>/api/doku/notify
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Only if a proxy rewrites the path DOKU sees (signature covers the path).
DOKU_NOTIFY_PATH=

# Public business details on /pricing, /terms, /privacy, /refund, /contact.
# Payment gateways review these pages: fill in real values before applying.
BUSINESS_NAME=zippp
BUSINESS_OPERATOR=
BUSINESS_ADDRESS=
CONTACT_EMAIL=asilverspoong@gmail.com
CONTACT_WA=
# Signs the contact-page email reveal challenge. Falls back to TOKEN_ENCRYPTION_KEY.
CONTACT_REVEAL_SECRET=

# Admin eval: approving a lesson opens a branch and a pull request.
# GITHUB_TOKEN is a fine-grained token scoped to GITHUB_REPO with
# Contents: Read and write and Pull requests: Read and write.
GITHUB_TOKEN=
GITHUB_REPO=masjames/zippp.link
# Optional: powers the manual Deploy now button on /admin/releases.
VERCEL_DEPLOY_HOOK_URL=
