# Gemini (Phase 0 mill) — server only
GEMINI_API_KEY=

# z.ai (Zhipu GLM) — DEV/TEST ONLY, server only.
# EXTRACT_PROVIDER picks the /api/extract backend: "gemini" (default) or "zai".
# Only the gemini path is covered by the client-privacy promise in SPEC.md and
# PRICING.md ("paid Gemini, training off"). Set zai to iterate on extraction
# without spending Gemini quota — never route client receipts through it as-is.
EXTRACT_PROVIDER=
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.6v

# Google OAuth (Phase 1 Sheets) — server only, never NEXT_PUBLIC_
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# OAuth scopes (set in code): spreadsheets + drive.file
# After adding drive.file: Disconnect Google → Sign in again to re-consent.
# Also enable Google Drive API in Cloud Console (APIs & Services → Library).

# Optional but recommended: encrypt refresh tokens at rest (AES-256-GCM).
# Use a 64-char hex string (32 bytes), or any passphrase (SHA-256 derived).
# Generate hex: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional override for token store directory (default: <repo>/.data).
# Local dev only — on servers, prefer a durable backend below.
# ZIPPP_DATA_DIR=

# Durable token store backends (pick one; Vercel Blob wins if both are set).
# Records keep TOKEN_ENCRYPTION_KEY encryption regardless of backend.
# 1) Vercel Blob: set BLOB_READ_WRITE_TOKEN (from Vercel → Storage → Blob).
# 2) Upstash Redis REST: set both UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Without either, the filesystem store (ZIPPP_DATA_DIR / .data) is used.
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
