# Extraction pipeline (server only, never NEXT_PUBLIC_)
# EXTRACT_PROVIDER: "paddle" (default) = PaddleOCR-VL then DeepSeek Flash;
# "gemini" = skip straight to Gemini. Gemini is also the automatic fallback
# when the PaddleOCR or DeepSeek stage fails.
EXTRACT_PROVIDER=paddle

# PaddleOCR-VL via Baidu AI Studio — does the vision/OCR. Image goes here.
PADDLEOCR_AISTUDIO_TOKEN=
PADDLEOCR_MODEL=PP-OCRv6
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com

# DeepSeek Flash — structures OCR text, and is the last-resort vision fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=4000

# Attempt budgets. PaddleOCR gets enough room to finish through the AI Studio
# queue; on timeout we go to DeepSeek vision (cheap) and keep Gemini last.
PADDLEOCR_TIMEOUT_MS=10000
DEEPSEEK_TIMEOUT_MS=5500
GEMINI_TIMEOUT_MS=5500

# Optional: intermediate OCR payload sent to DeepSeek (currently "markdown").
OCR_FORMAT=markdown

# Fallback only (image -> receipt JSON).
GEMINI_API_KEY=

# Google OAuth (Phase 1 Sheets) — server only, never NEXT_PUBLIC_
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in Google Cloud Console
# Add all three: https://www.zippp.link/api/auth/callback, https://zippp.link/api/auth/callback, http://localhost:3000/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# OAuth scopes (set in code): spreadsheets + drive.file
# After adding drive.file: Disconnect Google → Sign in again to re-consent.
# Also enable Google Drive API in Cloud Console (APIs & Services → Library).

# Optional but recommended: encrypt refresh tokens at rest (AES-256-GCM).
# Use a 64-char hex string (32 bytes), or any passphrase (SHA-256 derived).
# Generate hex: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional override for token store directory (default: <repo>/.data).
# Local dev only — on servers, prefer a durable backend below.
# ZIPPP_DATA_DIR=

# Durable token store backends (pick one; Vercel Blob wins if both are set).
# Records keep TOKEN_ENCRYPTION_KEY encryption regardless of backend.
# 1) Vercel Blob: set BLOB_READ_WRITE_TOKEN (from Vercel → Storage → Blob).
# 2) Upstash Redis REST: set both UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Without either, the filesystem store (ZIPPP_DATA_DIR / .data) is used.
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL="REDACTED"
UPSTASH_REDIS_REST_TOKEN="REDACTED"
